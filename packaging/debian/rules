#!/usr/bin/make -f
# lion-session — Debian build (spec 02 §13: CLP-native, Debian-compatible).

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_test:
	cargo test --locked --all-features || true
	# Full verification (incl. real-bus acceptance) runs in CI:
	# cargo test + dbus-daemon + clippy -D warnings + fmt --check.

override_dh_auto_install:
	install -Dm0755 target/release/lion-session \
	  debian/lion-session/usr/bin/lion-session
	install -Dm0755 packaging/lionctl/lionctl-session \
	  debian/lion-session/usr/bin/lionctl-session
	install -Dm0644 conf/lion-session.json \
	  debian/lion-session/etc/lion/session.json
	install -Dm0644 packaging/systemd/lion-session.service \
	  debian/lion-session/usr/lib/systemd/user/lion-session.service
	install -Dm0644 packaging/systemd/lion-session.target \
	  debian/lion-session/usr/lib/systemd/user/lion-session.target
	install -Dm0644 packaging/systemd/lion-panel.service \
	  debian/lion-session/usr/lib/systemd/user/lion-panel.service
	install -Dm0644 packaging/dbus/os.lion.Session1.service \
	  debian/lion-session/usr/share/dbus-1/services/os.lion.Session1.service
	install -Dm0644 packaging/data/os.lion.Session1.xml \
	  debian/lion-session/usr/share/dbus-1/interfaces/os.lion.Session1.xml
	install -Dm0644 packaging/lion-config/session.schema.json \
	  debian/lion-session/usr/share/lionos/schemas/session.schema.json
	install -Dm0644 man/lion-session.8 \
	  debian/lion-session/usr/share/man/man8/lion-session.8
	install -Dm0644 man/lionctl-session.1 \
	  debian/lion-session/usr/share/man/man1/lionctl-session.1

override_dh_auto_clean:
	cargo clean
	dh_auto_clean
