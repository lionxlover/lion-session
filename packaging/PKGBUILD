# PKGBUILD for lion-session — Arch Linux / pacman packaging.
# Build:  makepkg -si

pkgname=lion-session
pkgver=0.3.0
pkgrel=1
pkgdesc="LionOS user session manager: compositor supervision, autostart, cooperative logout, idle escalation, logind integration"
arch=('x86_64' 'aarch64')
url="https://lionos.org/"
license=('MIT')
depends=('dbus' 'systemd' 'python')  # python only for the test fixtures
makedepends=('cargo')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "$pkgname-$pkgver"
    cargo build --frozen --release
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --frozen --all-targets
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/lion-session "$pkgdir/usr/bin/lion-session"
    install -Dm644 systemd/lion-session.target "$pkgdir/usr/lib/systemd/user/lion-session.target"
    install -Dm644 systemd/lion-session.service "$pkgdir/usr/lib/systemd/user/lion-session.service"
    install -Dm644 dbus-1/services/os.lionos.Session.service \
        "$pkgdir/usr/share/dbus-1/services/os.lionos.Session.service"
    install -Dm644 etc/lionos/session.toml "$pkgdir/etc/lionos/session.toml"
    for doc in README.md CHANGELOG.md STABILITY.md SECURITY.md; do
        install -Dm644 "$doc" "$pkgdir/usr/share/doc/lion-session/$doc"
    done
}
