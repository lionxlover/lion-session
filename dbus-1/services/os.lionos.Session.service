# D-Bus service activation for the LionOS session manager.
#
# Ships to /usr/share/dbus-1/services/ (session bus activation dir).
# `SystemdService` delegates start to the user manager so the manager
# lands in a proper cgroup with restart policy — the same pattern
# GNOME uses for org.gnome.SessionManager.

[D-BUS Service]
Name=os.lionos.Session
Exec=/usr/bin/lion-session
SystemdService=lion-session.service
